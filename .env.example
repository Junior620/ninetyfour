# ─── MVP (optionnel) ───────────────────────────────────────────────
# Les pages publiques fonctionnent sans services externes.
# Contact et candidatures nécessitent les services ci-dessous ; sinon réponse 503.
# Désactiver l'indexation des environnements de recette uniquement.
# SITE_INDEXING="disabled"

# URL publique canonique (www + HTTPS) — SEO / Open Graph / sitemap
NEXT_PUBLIC_SITE_URL="https://www.ninetyonefootacademy.com"

# Optionnel — Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optionnel — IndexNow (Bing / partenaires)
# INDEXNOW_KEY="your-indexnow-key-uuid"

# ─── Phase 2 — Supabase / PostgreSQL ───────────────────────────────
# À configurer quand la base de données sera branchée.

DATABASE_URL="postgresql://user:password@localhost:5432/ninetyone?schema=public"
# Si le mot de passe contient @ # etc., encoder l’URL (ex. @ → %40).
# Sur Supabase, préférer le connection pooler (IPv4) si db.*.supabase.co est en IPv6 only.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Emails transactionnels (Resend) ───────────────────────────────
# Accusés de réception (contact + recrutement) + notifications admin.
# Voir EMAIL-SETUP.md pour SPF / DKIM / DMARC.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Ninety One Foot Academy <noreply@your-verified-domain.com>"
EMAIL_REPLY_TO="contact@your-official-domain.com"
ADMIN_NOTIFICATION_EMAIL="admin@your-domain.com"
# Rétrocompatibilité (toujours lus en fallback) :
# SENDER_EMAIL=...
# ADMIN_EMAIL=...
# ─── Auth (Supabase Auth + session JWT app) ─────────────────────────
# Secret de signature des cookies de session (obligatoire en prod)
AUTH_SECRET="change-me-to-a-long-random-string"

# Mot de passe bootstrap du compte admin (obligatoire pour npm run db:seed)
# Crée / met à jour christianouragan@gmail.com (rôle admin, status active).
# Ne jamais committer la vraie valeur. À définir aussi sur Vercel.
ADMIN_BOOTSTRAP_PASSWORD="your-strong-admin-password"

# Legacy — scripts / rétrocompat uniquement (plus utilisé comme mot de passe UX)
# PRIVATE_SPACE_PASSWORD="legacy-only"


