{
  "name": "ninetyfour",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "matchlab:setup": "supabase start && node scripts/matchlab-local.mjs setup",
    "matchlab:migrate": "supabase migration up --local",
    "matchlab:dev": "node scripts/matchlab-local.mjs dev",
    "matchlab:test": "node scripts/matchlab-local.mjs test",
    "matchlab:build": "node scripts/matchlab-local.mjs build",
    "matchlab:start": "node scripts/matchlab-local.mjs start",
    "matchlab:test:http": "node --import tsx tests/matchlab.http.ts",
    "matchlab:test:routes": "node tests/matchlab.routes.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:setup": "prisma db push && npm run db:seed",
    "indexnow:key": "node --env-file=.env.local scripts/ensure-indexnow-key.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.23.0",
    "next": "^16.4.2",
    "next-intl": "^4.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.1",
    "resend": "^6.17.2",
    "shadcn": "^4.12.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^6.19.3",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
